# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA faça commit do arquivo ".env" (já está no .gitignore).

# Servidor e Conexão Direta Supabase PostgreSQL (Usado pelo Alembic e FastAPI)
DATABASE_URL=postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJECT_REF].supabase.co:5432/postgres
SUPABASE_URL=https://[SEU_PROJECT_REF].supabase.co
SUPABASE_KEY=sua_anon_ou_service_role_key

# Autenticação JWT
SECRET_KEY=sua_chave_secreta_jwt_super_segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Chaves de APIs
GEMINI_API_KEY=sua_chave_do_google_ai_studio
TELEGRAM_BOT_TOKEN=seu_token_obtido_no_botfather
TELEGRAM_WEBHOOK_SECRET=token_secreto_para_validar_webhook

# Bot do Telegram (opcionais — têm padrão no código)
# Username do bot sem "@", usado para montar o Deep Link t.me/<username>?start=<token>
TELEGRAM_BOT_USERNAME=meu_gestor_financeiro_bot
# URL pública HTTPS usada pelo scripts/setup_telegram_bot.py no setWebhook
TELEGRAM_WEBHOOK_URL=https://seu-dominio.com/api/v1/telegram/webhook
TELEGRAM_LINK_TOKEN_TTL_MINUTES=30
PRIVACY_POLICY_VERSION=2026-08-10

# Cascata do Gemini (modelo recente -> fallback estável)
GEMINI_MODEL_PRIMARY=gemini-flash-latest
GEMINI_MODEL_FALLBACK=gemini-2.5-flash

# Front-end (link enviado a quem ainda não conectou a conta)
WEB_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Mercado Financeiro
BRAPI_TOKEN=seu_token_opcional_da_brapi
MARKET_HTTP_TIMEOUT_SECONDS=10
QUOTE_STALE_AFTER_MINUTES=60
