# Copie este arquivo para ".env.local" (dentro de frontend/) e preencha com os valores reais.
# Estas são as chaves PÚBLICAS do Supabase, usadas pelo @supabase/supabase-js no browser.
# NUNCA coloque aqui a service_role key (essa fica só no backend).

NEXT_PUBLIC_SUPABASE_URL=https://[SEU_PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key

# URL da API FastAPI (local ou produção)
NEXT_PUBLIC_API_URL=http://localhost:8000
